TZ=Europe/London
INTERNAL_API_TOKEN=staging-local-token

# API
API_PORT=8080
DATABASE_URL=file:/app/data/events.sqlite
AB_ASSIGNMENT_MODE=sender_sticky
AB_FORCE_VARIANT=
DEFAULT_TIMEZONE=Europe/London
CONFIDENCE_AUTO_PUBLISH=0.85
CONFIDENCE_CONFIRM=0.60
LLM_API_URL=
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=Europe/London
GOOGLE_CALENDAR_SHARE_BASE_URL=https://calendar.google.com/calendar/r/eventedit
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
MEDIA_DIR=/app/data/media
MAX_MEDIA_BYTES=20971520
API_MAX_BODY_BYTES=25165824
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX_PER_SENDER=100
RATE_LIMIT_MAX_GLOBAL=1000
STAGING_SEED_EVENTS_ENABLED=true
STAGING_SEED_RESET_ON_START=true
STAGING_SEED_EVENTS_COUNT=20

# Bot (disabled in staging compose override)
BOT_NAME=event-bot
API_BASE_URL=http://api:8080
PARSER_SPLIT_MODE=sender_sticky
ENABLE_SENDER_ALLOWLIST=false
SENDER_ALLOWLIST=
SIMULATE_INCOMING=false
GROUPS_CONFIG_PATH=/app/config/groups.json
ENABLE_BAILEYS=false
BAILEYS_AUTH_DIR=/app/auth/state
BOT_ALLOW_FROM_ME=false
BOT_IGNORE_OLD_MESSAGES=true
BOT_DM_OBSERVE_MODE=all
BOT_RSVP_PHONE_NUMBER=
BOT_EVENT_ENRICH_TIMEOUT_MS=600000
BOT_PROCESSED_MESSAGE_TTL_MS=300000
BOT_REPUBLISH_POLL_MS=15000
MOCK_WHATSAPP_PHONE=447951901694

# Display
DISPLAY_PORT=3000
PUBLIC_API_URL=http://localhost:8080
DISPLAY_API_SERVER_URL=http://api:8080
PUBLIC_MEDIA_URL=http://localhost:8080
CAROUSEL_INTERVAL_MS=8000
DISPLAY_MAX_DAYS_AHEAD=60
DISPLAY_ENABLE_DEBUG=true
DISPLAY_PROXY_MAX_BODY_BYTES=25165824
DISPLAY_PROXY_MAX_MEDIA_BYTES=20971520
DISPLAY_TIMEZONE=Europe/London
DISPLAY_MOCK_WHATSAPP_UI=true
